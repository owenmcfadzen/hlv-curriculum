{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/owenmcfadzen/hlv-curriculum/schema/activities.schema.json",
  "title": "ACTIVITIES",
  "description": "Worksheet/activity entries linked from SCHEDULE blocks via code.",
  "type": "array",
  "items": { "$ref": "#/definitions/activity" },
  "definitions": {
    "activity": {
      "type": "object",
      "required": ["code", "track", "name", "when", "status", "shape"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][0-9]+$",
          "description": "Unique activity code (e.g. P1, B2, M3)"
        },
        "track": {
          "type": "string",
          "enum": ["product", "business", "market"]
        },
        "name": { "type": "string", "description": "Activity title" },
        "when": { "type": "string", "description": "Human-readable timing (e.g. 'Tue AM · Phase 1')" },
        "status": {
          "type": "string",
          "enum": ["built", "partial"],
          "description": "Worksheet build state"
        },
        "shape": {
          "type": "string",
          "description": "Methodology, 2-3 sentences"
        },
        "feeds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Downstream consumers (e.g. 'LPP \"Channels\"', 'PRD Product')"
        },
        "open": {
          "type": ["string", "null"],
          "description": "Optional unresolved question"
        },
        "note": {
          "type": ["string", "null"],
          "description": "Optional context note"
        },
        "wireframe": { "$ref": "#/definitions/wireframe" }
      }
    },
    "wireframe": {
      "type": "object",
      "required": ["viewBox", "zones"],
      "properties": {
        "viewBox": { "type": "string" },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" },
              "fill": { "type": "string" },
              "num": { "type": "string" },
              "tag": { "type": "string" },
              "title": { "type": "string" },
              "sub": { "type": "string" },
              "center": { "type": "boolean" },
              "big": { "type": "boolean" },
              "dark": { "type": "boolean" }
            }
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2"],
            "properties": {
              "x1": { "type": "number" },
              "y1": { "type": "number" },
              "x2": { "type": "number" },
              "y2": { "type": "number" },
              "dashed": { "type": "boolean" },
              "label": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
