{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/owenmcfadzen/hlv-curriculum/schema/days.schema.json",
  "title": "DAYS",
  "description": "One entry per day across the program. Drives day-level theme/lead/takeaway.",
  "type": "array",
  "items": { "$ref": "#/definitions/day" },
  "definitions": {
    "day": {
      "type": "object",
      "required": ["weekIdx", "dayIdx", "theme", "lead", "takeaway"],
      "properties": {
        "weekIdx": {
          "type": "integer",
          "minimum": 0,
          "description": "0 = Wk1, 1 = Wk2 (extend if program is longer)"
        },
        "dayIdx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 = Mon, 4 = Fri"
        },
        "theme": {
          "type": "string",
          "description": "One short phrase, the day's headline (e.g. 'Problems')"
        },
        "lead": {
          "type": "string",
          "description": "1-2 sentences, the day's framing"
        },
        "takeaway": {
          "type": "string",
          "description": "2-3 sentences, the line you say out loud"
        }
      }
    }
  }
}
